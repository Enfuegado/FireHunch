  lines:
  - speakerName: Valentina
    portrait: {fileID: 21300000, guid: 118d734e196482849b4b51626676e530, type: 3}
    text: Me cuesta respirar..
    duration: 2.5
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "A m\xED tambi\xE9n... apenas puedo hacerlo."
    duration: 3.2
  - speakerName: Valentina
    portrait: {fileID: 21300000, guid: 118d734e196482849b4b51626676e530, type: 3}
    text: Tenemos que salir de este humo.
    duration: 2.6
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: Vamos... no puedo seguir respirando esto.
    duration: 3.2
