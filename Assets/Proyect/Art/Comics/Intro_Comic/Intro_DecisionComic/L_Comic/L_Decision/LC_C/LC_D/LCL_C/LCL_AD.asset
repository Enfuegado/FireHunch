  m_Script: {fileID: 11500000, guid: 4b8e712ff30e3f7468b61b77e1cd3650, type: 3}
  m_Name: LCL_AD
  m_EditorClassIdentifier: Assembly-CSharp::AmbientDialogueSequence
  lines:
  - speakerName: Valentina
    portrait: {fileID: 21300000, guid: 118d734e196482849b4b51626676e530, type: 3}
    text: "\xBFQu\xE9 haremos ahora? \xBFC\xF3mo escaparemos?"
    duration: 3.2
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: Solo nos queda ir a las escaleras de emergencia.
    duration: 3.3
  - speakerName: Valentina
    portrait: {fileID: 21300000, guid: 118d734e196482849b4b51626676e530, type: 3}
    text: "\xBFHay escaleras de emergencia?"
    duration: 2.2
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "[Suspiro de decepci\xF3n]"
    duration: 1.4
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "S\xF3lo s\xEDgueme."
    duration: 2
  - speakerName: Valentina
    portrait: {fileID: 21300000, guid: 118d734e196482849b4b51626676e530, type: 3}
    text: "Como t\xFA digas."
    duration: 2
