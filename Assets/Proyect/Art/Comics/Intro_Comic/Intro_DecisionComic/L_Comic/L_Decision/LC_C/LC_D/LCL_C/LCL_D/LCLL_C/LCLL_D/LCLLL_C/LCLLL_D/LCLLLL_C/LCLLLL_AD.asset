  m_Script: {fileID: 11500000, guid: 4b8e712ff30e3f7468b61b77e1cd3650, type: 3}
  m_Name: LCLLLL_AD
  m_EditorClassIdentifier: Assembly-CSharp::AmbientDialogueSequence
  lines:
  - speakerName: Beto
    portrait: {fileID: 21300000, guid: f9a32a8cbfaa756428b704dee5a289bf, type: 3}
    text: Marcos, te debo la vida, gracias.
    duration: 2.8
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "No hay de qu\xE9, no quiero perder m\xE1s gente."
    duration: 3.2
  - speakerName: Beto
    portrait: {fileID: 21300000, guid: f9a32a8cbfaa756428b704dee5a289bf, type: 3}
    text: "\xBFM\xE1s gente? \xBFA qu\xE9 te refieres...?"
    duration: 2.5
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "Valentina no lo logr\xF3..."
    duration: 2.4
  - speakerName: Beto
    portrait: {fileID: 21300000, guid: f9a32a8cbfaa756428b704dee5a289bf, type: 3}
    text: No es cierto...
    duration: 1.8
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: Tenemos que continuar.
    duration: 2.3
