  m_Script: {fileID: 11500000, guid: 4b8e712ff30e3f7468b61b77e1cd3650, type: 3}
  m_Name: CCC_AD
  m_EditorClassIdentifier: Assembly-CSharp::AmbientDialogueSequence
  lines:
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "No puedo distraerme... Beto encontrar\xE1 la forma de escapar."
    duration: 3.8
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: Debo apurarme antes de que alguna salida se bloquee.
    duration: 3.7
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "\xBFSer\xE1 que Valentina habr\xE1 escapado?"
    duration: 2.8
  - speakerName: Marcos
    portrait: {fileID: 21300000, guid: 96d4161f63615044db4a2467afea0a3d, type: 3}
    text: "Un momento... \xBFqu\xE9 es eso m\xE1s adelante?"
    duration: 3.2
